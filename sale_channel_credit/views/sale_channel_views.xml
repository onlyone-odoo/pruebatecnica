<odoo>

    <record id="view_sale_channel_list" model="ir.ui.view">
        <field name="name">sale.channel.list</field>
        <field name="model">sale.channel</field>
        <field name="arch" type="xml">
            <list string="Sales Channels">
                <field name="code"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="invoice_journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sale_channel_form" model="ir.ui.view">
        <field name="name">sale.channel.form</field>
        <field name="model">sale.channel</field>
        <field name="arch" type="xml">
            <form string="Sales Channel">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Channel name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="warehouse_id"
                                   domain="[('company_id', '=', company_id)]"/>
                            <field name="invoice_journal_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sale_channel_search" model="ir.ui.view">
        <field name="name">sale.channel.search</field>
        <field name="model">sale.channel</field>
        <field name="arch" type="xml">
            <search string="Sales Channels">
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <field name="invoice_journal_id"/>
                <group expand="0" string="Group By">
                    <filter string="Warehouse" name="group_by_warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Invoice Journal" name="group_by_journal"
                            context="{'group_by': 'invoice_journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_channel" model="ir.actions.act_window">
        <field name="name">Sales Channels</field>
        <field name="res_model">sale.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a sales channel
            </p>
            <p>
                A channel sets the warehouse used for deliveries and the journal used for invoices.
            </p>
        </field>
    </record>

</odoo>
