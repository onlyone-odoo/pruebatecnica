<odoo>

    <record id="view_picking_form_channel" model="ir.ui.view">
        <field name="name">stock.picking.form.channel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="channel_id"/>
            </field>
        </field>
    </record>

    <record id="view_picking_list_channel" model="ir.ui.view">
        <field name="name">stock.picking.list.channel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="channel_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_picking_search_channel" model="ir.ui.view">
        <field name="name">stock.picking.search.channel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="channel_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter string="Sales Channel" name="group_by_channel_id"
                        context="{'group_by': 'channel_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
