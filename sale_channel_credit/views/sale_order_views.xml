<odoo>

    <record id="view_order_form_channel" model="ir.ui.view">
        <field name="name">sale.order.form.channel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="channel_id"
                       readonly="state in ('cancel', 'sale')"
                       options="{'no_create': True}"/>
                <field name="credit_state"
                       widget="badge"
                       readonly="1"
                       decoration-muted="credit_state == 'no_limit'"
                       decoration-success="credit_state == 'available'"
                       decoration-danger="credit_state == 'blocked'"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_list_channel" model="ir.ui.view">
        <field name="name">sale.order.list.channel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="channel_id" optional="show"/>
                <field name="credit_state"
                       widget="badge"
                       optional="show"
                       decoration-muted="credit_state == 'no_limit'"
                       decoration-success="credit_state == 'available'"
                       decoration-danger="credit_state == 'blocked'"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_channel" model="ir.ui.view">
        <field name="name">sale.order.search.channel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="channel_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter string="Sales Channel" name="group_by_channel_id"
                        context="{'group_by': 'channel_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
